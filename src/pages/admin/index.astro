---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
---
<BaseLayout title="管理后台" description="文章管理">
  <section class="admin-page">
    <div class="wrap">
      <div class="admin-header">
        <div class="admin-title-group">
          <span class="admin-label">MANAGE</span>
          <h1>文章管理</h1>
        </div>
        <a href="/admin/new" class="btn-new">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          写新文章
        </a>
      </div>

      <div class="admin-filters" id="admin-filters">
        <button type="button" class="filter-tab is-active" data-filter="all">全部 <span class="filter-count" data-count="all">0</span></button>
        <button type="button" class="filter-tab" data-filter="published">已发布 <span class="filter-count" data-count="published">0</span></button>
        <button type="button" class="filter-tab" data-filter="draft">草稿 <span class="filter-count" data-count="draft">0</span></button>
      </div>

      <div id="admin-list">
        <div class="admin-loading"><div class="loading-dot"></div><span>加载中…</span></div>
      </div>
    </div>
  </section>
  <script>
    import { showConfirm, showAlert } from '../../utils/admin-dialog';

    const list = document.getElementById('admin-list') as HTMLElement;
    const filters = document.getElementById('admin-filters') as HTMLElement;
    let allPosts: any[] = [];
    let currentFilter: 'all' | 'published' | 'draft' = 'all';

    async function loadPosts() {
      try {
        const res = await fetch('/api/posts');
        allPosts = await res.json();
        updateCounts();
        renderPosts();
      } catch {
        list.innerHTML = '<div class="admin-empty"><p>加载失败</p></div>';
      }
    }

    function updateCounts() {
      const published = allPosts.filter((p) => p.status !== 'draft').length;
      const drafts = allPosts.filter((p) => p.status === 'draft').length;
      const setCount = (key: string, n: number) => {
        const el = filters.querySelector(`[data-count="${key}"]`);
        if (el) el.textContent = String(n);
      };
      setCount('all', allPosts.length);
      setCount('published', published);
      setCount('draft', drafts);
    }

    function filteredPosts() {
      if (currentFilter === 'draft') return allPosts.filter((p) => p.status === 'draft');
      if (currentFilter === 'published') return allPosts.filter((p) => p.status !== 'draft');
      return allPosts;
    }

    function renderPosts() {
      const posts = filteredPosts();
      if (!posts || posts.length === 0) {
        const emptyText =
          currentFilter === 'draft' ? '还没有草稿' :
          currentFilter === 'published' ? '还没有已发布文章' :
          '还没有文章';
        list.innerHTML = '<div class="admin-empty"><p>' + emptyText + '</p></div>';
        return;
      }

      list.innerHTML = '<div class="post-cards">' + posts.map(function(p, i) {
        const isDraft = p.status === 'draft';
        const viewBtn = isDraft
          ? ''
          : '<a href="/posts/' + p.slug + '" target="_blank" class="card-btn card-btn-view">' +
              '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>' +
              '<span>查看</span></a>';
        const publishBtn = isDraft
          ? '<button type="button" class="card-btn card-btn-publish" data-id="' + p.id + '" data-title="' + p.title + '">' +
              '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>' +
              '<span>发布</span></button>'
          : '';
        return '<article class="post-card' + (isDraft ? ' is-draft' : '') + '" style="animation-delay:' + (i * 0.05) + 's">' +
          '<div class="card-meta">' +
            '<span class="card-date">' + new Date(p.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) + '</span>' +
            '<span class="card-mood">' + p.mood + '</span>' +
            (isDraft ? '<span class="card-status">草稿</span>' : '') +
          '</div>' +
          '<h3 class="card-title">' +
            (isDraft
              ? '<a href="/admin/edit/' + p.id + '">' + p.title + '</a>'
              : '<a href="/posts/' + p.slug + '" target="_blank">' + p.title + '</a>') +
          '</h3>' +
          '<p class="card-excerpt">' + (p.excerpt || '').substring(0, 80) + '</p>' +
          '<div class="card-foot">' +
            '<div class="card-tags">' + (p.tags || []).map(function(t: string) { return '<span class="card-tag">' + t + '</span>'; }).join('') + '</div>' +
            '<div class="card-actions">' +
              publishBtn +
              viewBtn +
              '<a href="/admin/edit/' + p.id + '" class="card-btn card-btn-edit">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>' +
                '<span>编辑</span></a>' +
              '<button type="button" class="card-btn card-btn-del" data-id="' + p.id + '" data-title="' + p.title + '">' +
                '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>' +
                '<span>删除</span></button>' +
            '</div>' +
          '</div>' +
        '</article>';
      }).join('') + '</div>';

      list.querySelectorAll('.card-btn-publish').forEach(function(btn) {
        btn.addEventListener('click', async function(e) {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.id;
          const title = target.dataset.title;
          const ok = await showConfirm({
            title: '发布文章',
            message: '确定发布「' + title + '」吗？发布后将在前台公开可见。',
            confirmText: '确认发布',
            tone: 'success',
          });
          if (!ok) return;
          target.disabled = true;
          target.querySelector('span')!.textContent = '发布中…';
          try {
            const res = await fetch('/api/posts/' + id, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: 'published' }),
            });
            if (res.ok) {
              loadPosts();
            } else {
              const data = await res.json().catch(() => ({}));
              await showAlert({
                title: '发布失败',
                message: data.error || '发布失败，请稍后重试。',
                tone: 'danger',
              });
              target.disabled = false;
              target.querySelector('span')!.textContent = '发布';
            }
          } catch {
            await showAlert({ title: '发布失败', message: '网络错误，请稍后重试。', tone: 'danger' });
            target.disabled = false;
            target.querySelector('span')!.textContent = '发布';
          }
        });
      });

      list.querySelectorAll('.card-btn-del').forEach(function(btn) {
        btn.addEventListener('click', async function(e) {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.dataset.id;
          const title = target.dataset.title;
          const ok = await showConfirm({
            title: '删除文章',
            message: '确定删除「' + title + '」吗？此操作不可撤销。',
            confirmText: '确认删除',
            tone: 'danger',
          });
          if (!ok) return;
          target.closest('.post-card')?.classList.add('deleting');
          try {
            const res = await fetch('/api/posts/' + id, { method: 'DELETE' });
            if (res.ok) {
              loadPosts();
            } else {
              await showAlert({ title: '删除失败', message: '删除失败，请稍后重试。', tone: 'danger' });
              target.closest('.post-card')?.classList.remove('deleting');
            }
          } catch {
            await showAlert({ title: '删除失败', message: '网络错误，请稍后重试。', tone: 'danger' });
            target.closest('.post-card')?.classList.remove('deleting');
          }
        });
      });
    }

    filters.querySelectorAll('.filter-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        currentFilter = (tab as HTMLElement).dataset.filter as typeof currentFilter;
        filters.querySelectorAll('.filter-tab').forEach((t) => t.classList.toggle('is-active', t === tab));
        renderPosts();
      });
    });

    loadPosts();
  </script>
</BaseLayout>
<style is:global>
  .admin-page { padding: 72px 0 96px; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .admin-title-group { display: flex; flex-direction: column; gap: 6px; }
  .admin-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: var(--ink-faint); text-transform: uppercase; }
  .admin-header h1 { font-size: 36px; font-weight: 900; margin: 0; letter-spacing: 0.02em; }
  .btn-new { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 13px; padding: 11px 22px; background: var(--ink); color: var(--paper); border-radius: 3px; transition: all 0.25s ease; box-shadow: var(--shadow); text-decoration: none; }
  .btn-new:hover { background: var(--accent); transform: translateY(-1px); }
  .admin-filters { display: flex; gap: 8px; margin-bottom: 28px; flex-wrap: wrap; }
  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab:hover { color: var(--accent); border-color: var(--accent-soft); }
  .filter-tab.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .filter-count {
    font-size: 11px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.15);
  }
  .filter-tab:not(.is-active) .filter-count { background: var(--paper-deep); color: var(--ink-faint); }
  .admin-loading { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 80px 0; color: var(--ink-faint); font-size: 14px; }
  .loading-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 1.2s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.2); } }
  .admin-empty { text-align: center; padding: 80px 0; color: var(--ink-faint); }
  .admin-empty p { font-size: 15px; margin: 0 0 8px; }
  .post-cards { display: flex; flex-direction: column; gap: 16px; }
  .post-card {
    display: flex;
    flex-direction: column;
    padding: 22px 24px 18px;
    background: var(--paper-alt);
    border: 1px solid var(--line);
    border-radius: 4px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
    opacity: 0;
    transform: translateY(10px);
    animation: cardIn 0.4s ease forwards;
  }
  .post-card.is-draft { border-style: dashed; background: rgba(251,248,242,0.7); }
  @keyframes cardIn { to { opacity: 1; transform: translateY(0); } }
  .post-card:hover { border-color: var(--accent-soft); box-shadow: 0 4px 12px rgba(43,38,32,0.06); }
  .post-card.deleting { opacity: 0.4; transform: scale(0.98); }
  .card-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
  .card-date { font-family: 'EB Garamond', serif; font-style: italic; font-size: 14px; color: var(--ink-faint); }
  .card-mood { font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 20px; color: var(--accent); background: rgba(91,75,138,0.05); }
  .card-status { font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 2px 8px; border-radius: 20px; color: #8a6d3b; background: rgba(196,152,66,0.12); border: 1px solid rgba(196,152,66,0.28); }
  .card-title { font-size: 18px; font-weight: 600; margin: 0 0 8px; line-height: 1.4; }
  .card-title a { text-decoration: none; color: inherit; }
  .card-title a:hover { color: var(--accent); }
  .card-excerpt { font-size: 14px; color: var(--ink-soft); margin: 0 0 16px; line-height: 1.5; }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .card-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 2px 8px; border: 1px solid var(--line); border-radius: 20px; color: var(--moss); background: rgba(124,138,82,0.06); }
  .card-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .card-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 11px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
    color: var(--ink-soft);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .card-btn svg { flex-shrink: 0; }
  .card-btn-view:hover { color: var(--accent); background: rgba(91,75,138,0.08); border-color: rgba(91,75,138,0.18); }
  .card-btn-publish:hover { color: var(--moss); background: rgba(116,128,82,0.12); border-color: rgba(116,128,82,0.28); }
  .card-btn-edit:hover { color: var(--moss); background: rgba(116,128,82,0.1); border-color: rgba(116,128,82,0.22); }
  .card-btn-del:hover { color: #b33a2b; background: rgba(192,57,43,0.08); border-color: rgba(192,57,43,0.18); }
  .card-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  @media (max-width: 720px) {
    .admin-header { flex-direction: column; align-items: flex-start; gap: 20px; }
    .post-card { padding: 18px; }
    .card-foot { flex-direction: column; align-items: stretch; gap: 12px; }
    .card-actions { justify-content: flex-start; }
  }
</style>
