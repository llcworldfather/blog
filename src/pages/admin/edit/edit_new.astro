---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="编辑文章" description="编辑文章">
  <section class="admin-page">
    <div class="wrap">
      <div class="admin-header">
        <div class="admin-title-group">
          <span class="admin-label">EDIT POST</span>
          <h1>编辑文章</h1>
        </div>
        <a href="/admin" class="admin-back">← 返回列表</a>
      </div>

      <form id="post-form" class="post-form">
        <p class="admin-loading">加载文章中…</p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('post-form') as HTMLFormElement;
    const postId = window.location.pathname.split('/').pop();

    async function loadPost() {
      try {
        const res = await fetch('/api/posts/' + postId);
        if (!res.ok) { form.innerHTML = '<p class="admin-error">文章不存在或加载失败</p>'; return; }
        const post = await res.json();
        renderForm(post);
      } catch { form.innerHTML = '<p class="admin-error">加载失败</p>'; }
    }

    function renderForm(post: any) {
      const dateStr = new Date(post.date).toISOString().split('T')[0];
      form.innerHTML =
        '<div class="form-row"><label for="title">标题</label><input type="text" id="title" value="' + post.title + '" required /></div>' +
        '<div class="form-grid">' +
          '<div class="form-row"><label for="slug">URL 标识 (slug)</label><input type="text" id="slug" value="' + post.slug + '" required /></div>' +
          '<div class="form-row"><label for="date">日期</label><input type="date" id="date" value="' + dateStr + '" required /></div>' +
          '<div class="form-row"><label for="mood">心情/天气</label><select id="mood" required>' +
            ['晴','多云','雨','夜','风','雪','雾'].map((m: string) => '<option value="' + m + '" ' + (post.mood === m ? 'selected' : '') + '>' + m + '</option>').join('') +
          '</select></div>' +
          '<div class="form-row"><label for="tags">标签</label><input type="text" id="tags" value="' + (post.tags || []).join(', ') + '" /><p class="form-hint">多个标签用英文逗号隔开</p></div>' +
        '</div>' +
        '<div class="form-row"><label for="excerpt">摘要</label><textarea id="excerpt" rows="2" required>' + post.excerpt + '</textarea></div>' +
        '<div class="form-row"><label for="content">正文 (Markdown)</label><textarea id="content" rows="20" required>' + post.content + '</textarea></div>' +
        '<div class="form-actions"><button type="submit" id="submit-btn" class="admin-btn">保存修改</button><a href="/admin" class="form-cancel">取消</a></div>' +
        '<p class="form-msg" id="form-msg"></p>';
      form.addEventListener('submit', handleSubmit);
    }

    async function handleSubmit(e: Event) {
      e.preventDefault();
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const msg = document.getElementById('form-msg') as HTMLParagraphElement;
      btn.disabled = true; btn.textContent = '保存中…'; msg.textContent = '';
      const tags = (document.getElementById('tags') as HTMLInputElement).value.split(',').map((t) => t.trim()).filter(Boolean);
      const body = {
        title: (document.getElementById('title') as HTMLInputElement).value,
        slug: (document.getElementById('slug') as HTMLInputElement).value,
        date: (document.getElementById('date') as HTMLInputElement).value,
        mood: (document.getElementById('mood') as HTMLSelectElement).value,
        tags, excerpt: (document.getElementById('excerpt') as HTMLTextAreaElement).value,
        content: (document.getElementById('content') as HTMLTextAreaElement).value,
      };
      try {
        const res = await fetch('/api/posts/' + postId, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) { msg.style.color = 'var(--moss)'; msg.textContent = '保存成功！正在跳转…'; setTimeout(() => window.location.href = '/admin', 1000); }
        else { msg.style.color = 'var(--accent)'; msg.textContent = '保存失败'; btn.disabled = false; btn.textContent = '保存修改'; }
      } catch { msg.style.color = 'var(--accent)'; msg.textContent = '网络错误'; btn.disabled = false; btn.textContent = '保存修改'; }
    }

    loadPost();
  </script>
</BaseLayout>

<style>
  .admin-page { padding: 72px 0 96px; }
  .admin-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .admin-title-group { display: flex; flex-direction: column; gap: 6px; }
  .admin-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.2em; color: var(--ink-faint); text-transform: uppercase; }
  .admin-header h1 { font-size: 36px; font-weight: 900; margin: 0; letter-spacing: 0.02em; }
  .admin-back { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-soft); display: inline-flex; align-items: center; gap: 6px; transition: color 0.2s ease; }
  .admin-back:hover { color: var(--accent); }
  .post-form { max-width: 760px; }
  .form-row { margin-bottom: 28px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .form-row label { display: block; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ink-faint); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.1em; }
  .form-row input, .form-row select, .form-row textarea {
    width: 100%; padding: 12px 16px; border: 1px solid var(--line); border-radius: 3px;
    background: var(--paper-alt); font-family: 'Noto Serif SC', serif; font-size: 15px; color: var(--ink);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-row input:focus, .form-row select:focus, .form-row textarea:focus {
    outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(91,75,138,0.08);
  }
  .form-row textarea { resize: vertical; font-family: 'JetBrains Mono', monospace; font-size: 14px; line-height: 1.7; }
  .form-hint { font-size: 12px; color: var(--ink-faint); margin: 8px 0 0; }
  .form-actions { display: flex; align-items: center; gap: 24px; margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--line); }
  .admin-btn {
    font-family: 'JetBrains Mono', monospace; font-size: 13px; padding: 12px 28px;
    background: var(--ink); color: var(--paper); border: none; border-radius: 3px;
    cursor: pointer; transition: all 0.25s ease; box-shadow: var(--shadow);
  }
  .admin-btn:hover { background: var(--accent); transform: translateY(-1px); }
  .admin-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .form-cancel { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-soft); transition: color 0.2s ease; }
  .form-cancel:hover { color: var(--accent); }
  .form-msg { font-family: 'JetBrains Mono', monospace; font-size: 13px; margin-top: 16px; min-height: 18px; }
  .admin-loading, .admin-error { color: var(--ink-soft); font-size: 15px; padding: 40px 0; }
  .admin-error { color: var(--accent); }
  @media (max-width: 720px) { .form-grid { grid-template-columns: 1fr; } }
</style>