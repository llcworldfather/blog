---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="登录" description="管理员登录">
  <section class="login-page">
    <div class="wrap">
      <div class="login-box">
        <h1>管理员登录</h1>
        <p class="login-sub">请输入管理密码</p>

        <form id="login-form">
          <div class="form-row">
            <input type="password" id="password" placeholder="管理密码" required autofocus />
          </div>
          <button type="submit" id="login-btn" class="login-btn">登录</button>
          <p class="login-msg" id="login-msg"></p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const btn = document.getElementById('login-btn') as HTMLButtonElement;
    const msg = document.getElementById('login-msg') as HTMLParagraphElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      btn.disabled = true;
      btn.textContent = '登录中…';
      msg.textContent = '';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json();
        if (res.ok) {
          msg.style.color = 'var(--moss)';
          msg.textContent = '登录成功！正在跳转…';
          setTimeout(() => (window.location.href = '/admin'), 800);
        } else {
          msg.style.color = 'var(--accent)';
          msg.textContent = data.error || '登录失败';
          btn.disabled = false;
          btn.textContent = '登录';
        }
      } catch {
        msg.style.color = 'var(--accent)';
        msg.textContent = '网络错误';
        btn.disabled = false;
        btn.textContent = '登录';
      }
    });
  </script>
</BaseLayout>

<style>
  .login-page {
    padding: 120px 0;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .login-box {
    max-width: 360px;
    margin: 0 auto;
    text-align: center;
  }
  .login-box h1 {
    font-size: 28px;
    font-weight: 800;
    margin: 0 0 8px;
  }
  .login-sub {
    color: var(--ink-soft);
    font-size: 14px;
    margin: 0 0 32px;
  }
  .form-row {
    margin-bottom: 20px;
  }
  .form-row input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--paper-alt);
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    color: var(--ink);
    text-align: center;
  }
  .form-row input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .login-btn {
    width: 100%;
    padding: 12px;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .login-btn:hover { background: var(--accent); }
  .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .login-msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    margin-top: 16px;
    min-height: 18px;
  }
</style>