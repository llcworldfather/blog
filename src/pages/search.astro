---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="搜索" description="搜索手记标题、正文与标签">
  <section class="search-page">
    <div class="wrap">
      <div class="search-intro">
        <span class="search-label">SEARCH</span>
        <h1>搜索手记</h1>
        <p class="search-sub">按标题、正文、标签或心情查找</p>
      </div>

      <form class="search-form" id="search-form" role="search">
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder="输入关键词…"
          autocomplete="off"
          autofocus
        />
        <button type="submit" class="search-submit">搜索</button>
      </form>

      <p class="search-status" id="search-status" aria-live="polite"></p>
      <div class="search-results" id="search-results"></div>
    </div>
  </section>

  <!--
    Pagefind 产物在 /public，Vite 不允许从源码 import。
    文章来自 Firestore SSR，搜索走 /api/search 更可靠；
    构建时仍会生成 Pagefind 索引供静态托管备用。
  -->
  <script>
    const form = document.getElementById('search-form') as HTMLFormElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const statusEl = document.getElementById('search-status') as HTMLElement;
    const resultsEl = document.getElementById('search-results') as HTMLElement;

    const params = new URLSearchParams(window.location.search);
    const initial = params.get('q')?.trim() ?? '';
    if (initial) {
      input.value = initial;
      runSearch(initial);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      syncQuery(q);
      runSearch(q);
    });

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        const q = input.value.trim();
        if (q.length >= 2 || q.length === 0) {
          syncQuery(q);
          runSearch(q);
        }
      }, 280);
    });

    function syncQuery(q: string) {
      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url.toString());
    }

    async function runSearch(q: string) {
      if (!q) {
        statusEl.textContent = '';
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = '搜索中…';
      resultsEl.innerHTML = '';

      try {
        const res = await fetch('/api/search?q=' + encodeURIComponent(q));
        const data = await res.json();
        if (!res.ok) {
          statusEl.textContent = data.error || '搜索失败，请稍后重试';
          return;
        }
        renderResults(q, data.results || []);
      } catch {
        statusEl.textContent = '搜索失败，请稍后重试';
      }
    }

    function renderResults(
      q: string,
      items: Array<{
        slug: string;
        title: string;
        excerpt?: string;
        mood?: string;
        minutes?: number;
        words?: number;
      }>
    ) {
      if (!items.length) {
        statusEl.textContent = `没有找到与「${q}」相关的手记`;
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = `找到 ${items.length} 篇与「${q}」相关的手记`;
      resultsEl.innerHTML = items
        .map((item) => {
          const meta = [
            item.mood,
            item.minutes ? `约 ${item.minutes} 分钟` : '',
            item.words ? `${item.words} 字` : '',
          ]
            .filter(Boolean)
            .join(' · ');
          return (
            '<a class="search-result" href="/posts/' + escapeHtml(item.slug) + '">' +
              '<strong class="search-result-title">' + escapeHtml(item.title) + '</strong>' +
              (meta ? '<span class="search-result-meta">' + escapeHtml(meta) + '</span>' : '') +
              (item.excerpt
                ? '<p class="search-result-excerpt">' + escapeHtml(item.excerpt) + '</p>'
                : '') +
            '</a>'
          );
        })
        .join('');
    }

    function escapeHtml(s: string) {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>
</BaseLayout>
