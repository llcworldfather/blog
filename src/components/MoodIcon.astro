---
// 心情/天气图标组件 — 根据 mood 字段渲染对应 SVG
interface Props {
  mood: '晴' | '多云' | '雨' | '夜' | '风' | '雪' | '雾';
  size?: number;
}

const { mood, size = 16 } = Astro.props;

const icons: Record<string, string> = {
  晴: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  多云: '<path d="M7 17a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.6 1.7A3.5 3.5 0 0 1 17 17H7Z"/>',
  雨: '<path d="M7 15a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.6 1.7A3.5 3.5 0 0 1 17 15H7Z"/><path d="M8 18v2M12 18v2M16 18v2"/>',
  夜: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/>',
  风: '<path d="M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h9"/>',
  雪: '<path d="M7 15a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.6 1.7A3.5 3.5 0 0 1 17 15H7Z"/><path d="M9 18l1 2M13 18l1 2M17 18l1 2"/>',
  雾: '<path d="M3 8h18M3 12h18M3 16h18"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  width={size}
  height={size}
  set:html={icons[mood] ?? icons['晴']}
></svg>