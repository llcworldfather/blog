---
import MoodIcon from './MoodIcon.astro';
import { slugify } from '../utils/slugify';
import { getReadingStats, formatPostDate } from '../utils/reading';
import type { Post } from '../utils/posts';

interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const dateLabel = formatPostDate(entry.date, false);
const stats = getReadingStats(entry.content);
---

<article class="entry">
  <span class="mood-icon" title={entry.mood}>
    <MoodIcon mood={entry.mood} />
  </span>
  <span class="entry-date">
    <span class="num">{dateLabel}</span> · {entry.mood}
    <span class="reading-meta"> · {stats.label}</span>
  </span>
  <h3><a href={`/posts/${entry.slug}`}>{entry.title}</a></h3>
  <p class="excerpt">{entry.excerpt}</p>
  <div class="entry-foot">
    {
      entry.tags.map((tag) => (
        <a href={`/tags/${slugify(tag)}`} class="tag">{tag}</a>
      ))
    }
    <a href={`/posts/${entry.slug}`} class="read-more">继续阅读 →</a>
  </div>
</article>
